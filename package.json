{
  "name": "turkcord",
  "productName": "Turkcord",
  "version": "0.7.0",
  "description": "Arkadaşlar arası sohbet uygulaması: sunucular, kanallar, DM ve sesli sohbet.",
  "author": "Turkcord",
  "homepage": "https://github.com/Esehannn/turkcord",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:db": "bash scripts/db-test.sh",
    "check": "npm run typecheck && npm run test && npm run build",
    "dist:win": "npm run build && electron-builder --win --publish never"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@supabase/supabase-js": "2.117.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.1",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^7.3.7",
    "zustand": "^5.0.15"
  },
  "dependencies": {
    "@sapphi-red/web-noise-suppressor": "0.4.1",
    "electron-updater": "6.8.10"
  }
